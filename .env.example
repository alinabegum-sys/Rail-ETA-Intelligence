# ==============================================================================
# RailETA Intelligence Platform (SIH26028) - Environment Configuration Template
# ==============================================================================

# Backend Service
PORT=8000
ENVIRONMENT=development

# Database (Default: local SQLite database, or PostgreSQL in production)
DATABASE_URL=sqlite:///./rail_eta.db
# DATABASE_URL=postgresql://username:password@localhost:5432/rail_eta_db

# Simulation Clock & Mechanics
SIMULATION_INTERVAL_SECONDS=2.5
SIMULATION_STEP_MINUTES=15

# CORS Allowed Origins
CORS_ORIGINS=["*"]
